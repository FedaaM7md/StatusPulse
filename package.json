{
  "name": "fedaa-statuspulse",
  "version": "1.0.0",
  "private": true,
  "license": "proprietary",
  "author": "Fedaa Mohamed",
  "description": "StatusPulse — Arabic-first uptime monitoring with a public status page",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:web": "vite build",
    "build": "npm run typecheck && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "tsx src/server/cli/create-admin.ts",
    "demo:reset": "tsx src/server/cli/demo-reset.ts",
    "seed:demo": "tsx src/server/cli/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@hono/node-server": "2.1.11",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.10.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "5.1.1"
  }
}
