# StatusPulse — example environment file.
# Copy to .env and adjust locally. Never commit the real .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=8106
DATABASE_PATH=./data/statuspulse.db
APP_URL=http://localhost:8106
APP_DEBUG=false
COOKIE_SECURE=false
# Guest access without registration. Set to false to remove demo entry points.
DEMO_MODE=true
# Shared demo dataset is rebuilt on this interval (minimum 5).
DEMO_RESET_MINUTES=60
